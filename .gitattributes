# GitHub Linguist Language Detection Configuration
# Ensure all database scripts are classified into unified SQL
*.sql linguist-detectable=true
*.sql linguist-language=SQL
database/*.sql linguist-detectable=true
database/*.sql linguist-language=SQL

# Exclude web presentation templates, styles, and assets
*.html linguist-detectable=false
*.css linguist-detectable=false
assets/** linguist-vendored=true

# Exclude batch and documentation scripts from language calculation
*.bat linguist-documentation=true
*.md linguist-documentation=true
*.txt linguist-documentation=true
